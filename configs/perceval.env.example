# Perceval training-time configuration. Copy to `configs/perceval.env` and edit
# to match your environment. Every script under `examples/perceval/` will source
# this file automatically when present.

# ---------------------------------------------------------------------------
# Models & data
# ---------------------------------------------------------------------------

# Policy / reference model. Either a local checkpoint or a HuggingFace repo id.
# The same path is used as the default tokenizer for token-position lookup in
# reward functions (override with PERCEVAL_TOKENIZER_PATH if you want a
# different tokenizer).
PERCEVAL_MODEL_PATH=/path/to/Qwen2.5-VL-3B-Instruct
# PERCEVAL_TOKENIZER_PATH=/path/to/Qwen2.5-VL-3B-Instruct  # optional

# RL training data (single parquet or HuggingFace dataset)
PERCEVAL_TRAIN_DATA=/path/to/deepeyes_image_in_info/train.parquet

# Validation data (Hydra list literal -- keep the surrounding [ and "]")
PERCEVAL_VAL_DATA=["/path/to/vstar_test/dataset_direct_attributes@1_idx.parquet","/path/to/vstar_test/dataset_relative_position@1_idx.parquet","/path/to/mathvista/testmini/train_idx.parquet"]

# ---------------------------------------------------------------------------
# Reward backends (LLM-as-judge and Process Reward Model)
# ---------------------------------------------------------------------------

# One or more space-separated OpenAI-compatible base URLs. Requests are
# load-balanced uniformly at random across the URLs in each list.
LLM_AS_A_JUDGE_BASE="http://0.0.0.0:9999/v1"
PRM_BASE="http://0.0.0.0:12298/v1 http://0.0.0.0:3456/v1 http://0.0.0.0:2789/v1"

# ---------------------------------------------------------------------------
# Output paths
# ---------------------------------------------------------------------------

# Where checkpoints and trainer artifacts are written.
PERCEVAL_RESULTS_DIR=/path/to/results

# Where stdout/stderr and per-step jsonl rollout records are written.
PERCEVAL_LOG_DIR=/path/to/logs

# Optional: dump tasks that failed all retries to this jsonl for inspection.
# Leave unset to disable.
# PERCEVAL_FAILED_TASK_LOG=/path/to/logs/failed_tasks.jsonl

# ---------------------------------------------------------------------------
# Optional Wandb settings
# ---------------------------------------------------------------------------
# export WANDB_PROJECT=perceval
# export WANDB_API_KEY=
